rules_version = '2';

// Todo el equipo comparte una sola base (un proyecto de Firebase = una
// iglesia, ver README) — por eso cualquiera que esté logueado puede leer
// todo el contenido compartido (repertorio, setlists, equipo). Antes
// "allow read: if true" dejaba leer toda la base a cualquiera en
// internet, sin cuenta ni la app instalada — la configuración de
// Firebase va embebida en el APK, no es secreta, así que hacía falta
// esto antes de distribuir la app en público.
//
// Importante: las reglas de Firestore se combinan con OR entre todos los
// bloques `match` que apliquen a una ruta — un bloque específico NO
// puede volverse más estricto que uno genérico que también matchee esa
// misma ruta. Por eso acá no hay un comodín de escritura para
// `{document=**}` como con la lectura: cada colección tiene su propio
// bloque, para que la regla de `miembros` (más abajo) sea la única que
// decide qué se puede escribir ahí.
//
// No hay más reglas finas por rol (ej. "solo el líder puede borrar una
// canción") porque `Miembro.id` (el documento) no es el mismo valor que
// `Miembro.uid` (quién inició sesión) — una regla no puede buscar "el
// Miembro de este uid" sin una query, y las reglas de seguridad no
// pueden hacer queries, solo lecturas puntuales por id. Mientras ese
// modelo no cambie, el control de quién puede hacer qué sigue viviendo
// en la UI (ver EnVivoScreen.esLider, EquipoScreen.editable), no acá.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
    }

    match /ritmos/{id} {
      allow write: if request.auth != null;
    }
    match /artistas/{id} {
      allow write: if request.auth != null;
    }
    match /canciones/{id} {
      allow write: if request.auth != null;
    }
    match /actividades/{id} {
      allow write: if request.auth != null;
    }
    match /notas/{id} {
      allow write: if request.auth != null;
    }
    match /ejercicios/{id} {
      allow write: if request.auth != null;
    }

    // `miembros` necesita su propia regla porque "reclamar" un perfil
    // (Selección de rol) escribe el campo `uid` con un `set()` completo,
    // sin pasar por ningún chequeo de identidad — confía en que cada
    // quien elige su propio nombre de una lista. Sin esto, cualquier
    // cuenta nueva podría pisarle el `uid` a un integrante YA reclamado,
    // robándole la identidad — incluido el líder. Acá se sigue
    // permitiendo cambiar roles/nombre/etc. de otra persona (lo sigue
    // necesitando "Mi equipo" para que el líder administre al resto —
    // ver nota de arriba sobre por qué eso no se puede restringir solo
    // al líder), pero el campo `uid` en sí únicamente se puede fijar al
    // propio, y solo si el perfil todavía no tenía dueño.
    match /miembros/{miembroId} {
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.resource.data.uid == resource.data.uid ||
        (resource.data.uid == null && request.resource.data.uid == request.auth.uid)
      );
      allow delete: if false;
    }
  }
}
