rules_version = '2';

// Cada equipo tiene su propia base aislada (`equipos/{equipoId}/...` como
// subcolecciones) — antes de esto había una sola base compartida por
// cualquier cuenta que se creara en la app, sin importar si de verdad
// eran del mismo grupo. Ver `ElegirEquipoScreen` (crear equipo nuevo /
// unirse con código) y `ResolverEquipoScreen` (arma los repositorios ya
// apuntando al equipo correcto).
//
// `usuarioEquipo/{uid}` es la pieza clave que hace esto posible con
// reglas de seguridad de verdad: como está indexado por uid (no por un
// id autogenerado), una regla puede resolver "a qué equipo pertenece
// quien pide esto" con una lectura puntual (`get`), sin necesitar una
// query — las reglas de Firestore no permiten queries.
//
// Importante (ya nos pasó una vez): las reglas se combinan con OR entre
// todos los bloques `match` que apliquen a una misma ruta — un bloque
// específico no puede ser más estricto que uno genérico que también
// matchee ahí. Por eso cada subcolección tiene su propio bloque en vez
// de un comodín que las cubra todas.
service cloud.firestore {
  match /databases/{database}/documents {
    function equipoDeUsuario() {
      return get(/databases/$(database)/documents/usuarioEquipo/$(request.auth.uid)).data.equipoId;
    }

    // El directorio de equipos en sí — nombre y código, nada sensible.
    // Cualquiera logueado puede leerlo (hace falta para validar un
    // código al unirse) y crear uno nuevo; no se edita ni se borra por
    // ahora.
    match /equipos/{equipoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /ritmos/{id} {
        allow read, write: if request.auth != null && equipoDeUsuario() == equipoId;
      }
      match /artistas/{id} {
        allow read, write: if request.auth != null && equipoDeUsuario() == equipoId;
      }
      match /canciones/{id} {
        allow read, write: if request.auth != null && equipoDeUsuario() == equipoId;
      }
      match /actividades/{id} {
        allow read, write: if request.auth != null && equipoDeUsuario() == equipoId;
      }
      match /notas/{id} {
        allow read, write: if request.auth != null && equipoDeUsuario() == equipoId;
      }
      match /ejercicios/{id} {
        allow read, write: if request.auth != null && equipoDeUsuario() == equipoId;
      }

      // `miembros` necesita su propia regla, más allá del resto: crear o
      // reclamar un perfil pasa ANTES de que exista `usuarioEquipo/{uid}`
      // (es parte del mismo paso de unirse/crear equipo), así que
      // `equipoDeUsuario()` todavía no resuelve nada en ese momento —
      // por eso el "o" en `create`. El resto (leer, cambiar roles de
      // otra persona) ya exige pertenecer al equipo como siempre.
      //
      // Y la misma protección contra robo de identidad que ya existía:
      // el campo `uid` de un perfil ya reclamado no se puede pisar con
      // otro — solo se puede fijar una vez, al reclamarlo.
      match /miembros/{miembroId} {
        allow read: if request.auth != null && equipoDeUsuario() == equipoId;
        allow create: if request.auth != null && (
          equipoDeUsuario() == equipoId ||
          request.resource.data.uid == request.auth.uid
        );
        allow update: if request.auth != null && equipoDeUsuario() == equipoId && (
          request.resource.data.uid == resource.data.uid ||
          (resource.data.uid == null && request.resource.data.uid == request.auth.uid)
        );
        allow delete: if false;
      }
    }

    // A qué equipo pertenece cada cuenta — ver la función de arriba. Se
    // escribe una sola vez (al crear o unirse a un equipo) y nunca se
    // reasigna desde acá.
    match /usuarioEquipo/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if false;
    }
  }
}
