rules_version = '2';

// Foto de perfil — ver FotoPerfilService. Un archivo por persona
// (perfiles/<uid>.jpg): cualquiera logueado la puede ver (aparece en Mi
// equipo, En vivo, etc.), pero solo el dueño de esa cuenta puede
// subir/reemplazar la suya.
service firebase.storage {
  match /b/{bucket}/o {
    match /perfiles/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
